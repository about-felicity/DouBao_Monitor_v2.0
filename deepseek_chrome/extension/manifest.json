{
  "manifest_version": 3,
  "name": "DeepSeek对话监控（本地版）",
  "version": "0.2.22",
  "description": "低频逐题新建 DeepSeek 对话，采集回答正文与全部可见/网络信源，并保存到本机。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "downloads",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DeepSeek对话监控",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
